# ---- Core ----------------------------------------------------------------
# PostgreSQL connection string (dev: infra/docker-compose.dev.yml)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/asdri

# Encrypts JWTs and API keys. Generate: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Public URL, no trailing slash. Used for CORS, links, sitemap, OG tags.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Authenticates scheduled job requests (/api/jobs/run)
CRON_SECRET=change-me

# Validates draft preview requests
PREVIEW_SECRET=change-me

# ---- Media storage (S3 / MinIO) ------------------------------------------
# Leave S3_BUCKET empty to store uploads on local disk (dev only).
S3_BUCKET=asdri-media
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Public base URL for files (MinIO dev: http://127.0.0.1:9000/asdri-media)
S3_PUBLIC_URL=http://127.0.0.1:9000/asdri-media

# ---- Email (receipts, OTP, fatwa replies) --------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ASDRI <no-reply@example.org>"

# ---- Integrations (optional, see docs/04-gap-register.md) ----------------
YOUTUBE_API_KEY=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

# ---- Payments (see docs/adr/0003-payments-abstraction.md) ----------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
