# Environment for the Coolify "Docker Compose" resource (infra/docker-compose.coolify.yml).
# Paste into the resource's Environment Variables editor; generate real secrets with
#   openssl rand -hex 32
# Never commit a filled-in copy.

# --- Postgres (internal service, not exposed) ---
POSTGRES_USER=asdri
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=asdri

# --- App ---
PAYLOAD_SECRET=<openssl rand -hex 32>
PREVIEW_SECRET=<openssl rand -hex 16>
CRON_SECRET=<openssl rand -hex 16>
# Public URL of this deployment, no trailing slash
NEXT_PUBLIC_SERVER_URL=https://asdri.ailearnersbd.com

# --- Object storage (RustFS service in the same stack) ---
S3_BUCKET=asdri-media
S3_ACCESS_KEY=<openssl rand -hex 12>
S3_SECRET_KEY=<openssl rand -hex 24>
# Leave empty on staging: files are served through the app at /api/media/file/<name>,
# so no second domain is needed. Set to https://files.<domain>/asdri-media only when a
# public bucket domain exists.
S3_PUBLIC_URL=

# --- Email (optional until a provider exists; the app logs mail to the console when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ASDRI <no-reply@asdri.ailearnersbd.com>
